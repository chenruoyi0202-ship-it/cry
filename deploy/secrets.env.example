# /opt/cry/secrets.env
# 部署：
#   cp deploy/secrets.env.example /opt/cry/secrets.env
#   编辑填好值
#   chmod 600 /opt/cry/secrets.env

# Resend 邮件 API key（去 https://resend.com/api-keys 拿）
# run_daily.sh 会优先读这个；不设的话会回退到 send_digest_email.py 里内嵌的密文（不推荐）
RESEND_API_KEY=

# 微信推送（去 https://www.pushplus.plus/ 拿）。留空则跳过微信推送
PUSHPLUS_TOKEN=

# 收件邮箱
EMAIL_TO=512773445@qq.com

# 如果继续保留 GitHub 仓库做收藏云同步，可以把 PAT 写在这里供其它脚本用；
# 否则不必填
# GITHUB_PAT=
